---
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

import aboutImage from '~/assets/images/about-workbench.png';
import druImage from '~/assets/images/Dru_hero.png';

const metadata = {
  title: 'About Geeky Clean Technology | San Diego IT Support',
  description:
    'Geeky Clean Technology is a San Diego-based mobile and remote IT support company founded by Dru Macasieb. We provide white-glove technology help for homes and small businesses.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="About Us"
    title="Your San Diego Technology Partner"
    subtitle="White-glove IT support, built on trust, discretion, and deep hands-on experience with the technology that runs your life and business."
    actions={[
      { text: 'Schedule a Consultation', href: '/contact', variant: 'primary' },
      { text: 'Call Us', href: 'tel:+16192899205', variant: 'secondary' },
    ]}
    image={{
      src: druImage,
      alt: 'Dru Macasieb, founder of Geeky Clean Technology',
      class: 'mx-auto rounded-md w-full object-cover object-center aspect-video',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0F] to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0F] to-transparent"></div>
    </Fragment>
  </Hero>

  <Content
    isReversed
    tagline="Who we are"
    title="Expertise meets discretion"
    image={{ src: aboutImage, alt: 'Technician at a sleek workbench in a dark studio' }}
  >
    <Fragment slot="content">
      <p class="text-muted text-lg mb-4">
        Geeky Clean Technology was founded by Dru Macasieb to bring calm, competent, and highly personal technology
        support to homes and small businesses across San Diego. We blend on-site concierge service with secure remote
        help, so you get the right kind of support on your schedule.
      </p>
      <p class="text-muted text-lg mb-4">
        We serve residential clients, busy professionals, senior citizens and families, and small businesses that need
        dependable IT without the overhead of a full in-house department.
      </p>
      <p class="text-muted text-lg">
        Every engagement is handled directly by an experienced technician. We explain what is happening in plain
        language, protect your privacy, and stand behind our work.
      </p>
    </Fragment>
  </Content>

  <Features2
    id="why-us"
    title="Why work with us"
    tagline="The White-Glove Difference"
    columns={3}
    items={[
      {
        title: 'Mobile & On-Site',
        description:
          'We come to your home or office in the San Diego area when the issue requires a physical presence.',
        icon: 'tabler:car',
      },
      {
        title: 'Remote When You Need It',
        description:
          'Many issues can be resolved securely over a remote connection, saving you time and getting you back to work fast.',
        icon: 'tabler:wifi',
      },
      {
        title: 'Confidentiality First',
        description:
          'We respect your privacy. NDAs are available for high-profile, executive, and sensitive business work.',
        icon: 'tabler:lock',
      },
      {
        title: 'Warranty-Backed Work',
        description: 'We stand behind the services we provide. If something is not right, we will make it right.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Plain-Language Guidance',
        description: 'No jargon, no condescension. We teach as we work so you feel confident with your technology.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Broad Expertise',
        description:
          'From home networks and device setup to small-business strategy and cybersecurity guidance, we cover a wide range of needs.',
        icon: 'tabler:brain',
      },
    ]}
  />

  <CallToAction
    title="Ready to get your technology handled?"
    subtitle="Whether it is a single device or an ongoing business relationship, we are here to help."
    actions={[
      { text: 'Contact Us', href: '/contact', variant: 'primary' },
      { text: 'Call 619-289-9205', href: 'tel:+16192899205', variant: 'secondary' },
    ]}
  />
</Layout>
