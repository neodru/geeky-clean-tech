---
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact Geeky Clean Technology | Schedule IT Support',
  description:
    'Schedule on-site or remote IT support in San Diego. Call, text, or email Geeky Clean Technology for home, senior, business, and cybersecurity help.',
};

// Submissions go to the Pages Function in functions/api/contact.ts, which
// writes them to Notion. The override is for testing against another endpoint.
const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || '/api/contact';
// Turnstile bot check; only rendered when a site key is configured.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout metadata={metadata}>
  <Hero
    tagline="Contact"
    title="Let's get your technology handled"
    subtitle="Call, text, email, or send us a message. We typically respond the same business day."
    actions={[
      { text: 'Call 619-289-9205', href: 'tel:+16192899205', variant: 'primary' },
      { text: 'Email Us', href: 'mailto:support@geekycleantechnology.com', variant: 'secondary' },
    ]}
  />

  <section id="form" class="relative max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <gct-contact-form>
      <form action={endpoint} method="POST" class="glass-card p-6 sm:p-8 space-y-6">
        <div>
          <h2 class="text-2xl font-heading text-white mb-2">Request support</h2>
          <p class="text-muted text-sm">
            Tell us what is going on and we will get back to you, typically the same business day.
          </p>
        </div>

        <!-- Shown after a plain (JavaScript-disabled) submission redirects back here. -->
        <p id="sent" class="hidden target:block rounded-lg px-4 py-3 text-sm bg-green-500/10 text-green-300">
          Thanks! Your request is in. We typically respond the same business day.
        </p>
        <p id="send-error" class="hidden target:block rounded-lg px-4 py-3 text-sm bg-red-500/10 text-red-300">
          Sorry, your message could not be sent. Please call or text 619-289-9205, or email
          support@geekycleantechnology.com.
        </p>

        <!-- Honeypot: hidden from people, filled in by bots. -->
        <div class="hidden" aria-hidden="true">
          <label for="_gotcha">Leave this field empty</label>
          <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-sm font-medium mb-1">Name <span aria-hidden="true">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="w-full bg-page-dark border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
              placeholder="Your name"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium mb-1">Email <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full bg-page-dark border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
              placeholder="you@example.com"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="phone" class="block text-sm font-medium mb-1">Phone</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              class="w-full bg-page-dark border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
              placeholder="(619) 555-0100"
            />
          </div>
          <div>
            <label for="audience" class="block text-sm font-medium mb-1"
              >This is for <span aria-hidden="true">*</span></label
            >
            <select
              id="audience"
              name="audience"
              required
              class="w-full bg-page-dark border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors appearance-none"
            >
              <option value="" disabled selected>Select one</option>
              <option value="Home / Personal">Home / Personal</option>
              <option value="Senior / Family">Senior / Family</option>
              <option value="Business">Business</option>
            </select>
          </div>
        </div>

        <div>
          <label for="service" class="block text-sm font-medium mb-1"
            >Service needed <span aria-hidden="true">*</span></label
          >
          <select
            id="service"
            name="service"
            required
            class="w-full bg-page-dark border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors appearance-none"
          >
            <option value="" disabled selected>Select a service</option>
            <option value="Home IT Support">Home IT Support</option>
            <option value="Senior Tech Support">Senior Tech Support</option>
            <option value="Business IT Services">Business IT Services</option>
            <option value="Cybersecurity">Cybersecurity</option>
            <option value="Data Recovery">Data Recovery</option>
            <option value="Network Support">Network Support</option>
            <option value="Computer Repair">Computer Repair</option>
            <option value="Remote Support">Remote Support</option>
            <option value="Other / Not sure">Other / Not sure</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium mb-1"
            >How can we help? <span aria-hidden="true">*</span></label
          >
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="w-full bg-page-dark border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
            placeholder="Describe the issue, device, or project..."></textarea>
        </div>

        {turnstileSiteKey && <div data-turnstile data-sitekey={turnstileSiteKey} />}

        <p class="text-sm text-muted">
          Prefer to talk? Call or text <a href="tel:+16192899205" class="text-primary underline underline-offset-2"
            >619-289-9205</a
          >.
        </p>

        <button type="submit" class="btn btn-primary w-full">Request IT Support</button>

        <p data-form-status role="status" aria-live="polite" class="hidden rounded-lg px-4 py-3 text-sm"></p>
      </form>
    </gct-contact-form>
  </section>

  <Features2
    title="Other ways to reach us"
    columns={3}
    items={[
      {
        title: 'Call or Text',
        description: '<a href="tel:+16192899205" class="text-primary hover:underline">619-289-9205</a>',
        icon: 'tabler:phone',
      },
      {
        title: 'Email',
        description:
          '<a href="mailto:support@geekycleantechnology.com" class="text-primary hover:underline">support@geekycleantechnology.com</a>',
        icon: 'tabler:mail',
      },
      {
        title: 'Service Area',
        description: 'On-site appointments throughout San Diego and surrounding communities.',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>

<script>
  const SUCCESS_MESSAGE = 'Thanks! Your request is in. We typically respond the same business day.';
  const ERROR_MESSAGE =
    'Sorry, your message could not be sent. Please call or text 619-289-9205, or email support@geekycleantechnology.com.';

  interface Turnstile {
    render(container: HTMLElement, options: { sitekey: string }): string;
    reset(widgetId: string): void;
  }

  declare global {
    interface Window {
      turnstile?: Turnstile;
    }
  }

  let turnstileScript: Promise<Turnstile> | undefined;

  // Explicit rendering, so the widget also appears after ClientRouter navigations.
  function loadTurnstile(): Promise<Turnstile> {
    turnstileScript ??= new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.onload = () => (window.turnstile ? resolve(window.turnstile) : reject(new Error('Turnstile missing')));
      script.onerror = () => reject(new Error('Turnstile failed to load'));
      document.head.appendChild(script);
    });
    return turnstileScript;
  }

  class GctContactForm extends HTMLElement {
    private turnstileId?: string;

    connectedCallback() {
      const form = this.querySelector('form');
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        this.submit(form);
      });

      const widget = this.querySelector<HTMLElement>('[data-turnstile]');
      if (widget?.dataset.sitekey) {
        const sitekey = widget.dataset.sitekey;
        loadTurnstile()
          .then((turnstile) => {
            this.turnstileId = turnstile.render(widget, { sitekey });
          })
          .catch((err) => console.error(err));
      }
    }

    private async submit(form: HTMLFormElement) {
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const data = new FormData(form);

      // Bots fill the honeypot; pretend it worked so they do not retry.
      if (data.get('_gotcha')) {
        form.reset();
        this.showStatus(form, 'success', SUCCESS_MESSAGE);
        return;
      }

      const label = button?.textContent ?? '';
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (res.ok) {
          form.reset();
          this.showStatus(form, 'success', SUCCESS_MESSAGE);
        } else {
          // Validation problems (422) come back with a message worth showing.
          const body = (await res.json().catch(() => ({}))) as { error?: string };
          this.showStatus(form, 'error', res.status === 422 && body.error ? body.error : ERROR_MESSAGE);
        }
      } catch (err) {
        console.error(err);
        this.showStatus(form, 'error', ERROR_MESSAGE);
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = label;
        }
        // Turnstile tokens are single-use.
        if (this.turnstileId) window.turnstile?.reset(this.turnstileId);
      }
    }

    private showStatus(form: HTMLFormElement, kind: 'success' | 'error', message: string) {
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden', 'bg-green-500/10', 'text-green-300', 'bg-red-500/10', 'text-red-300');
      status.classList.add(
        ...(kind === 'success' ? ['bg-green-500/10', 'text-green-300'] : ['bg-red-500/10', 'text-red-300'])
      );
    }
  }

  customElements.define('gct-contact-form', GctContactForm);
</script>
