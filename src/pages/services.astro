---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { services } from '~/data/services';

const metadata = {
  title: 'IT Services in San Diego | Geeky Clean Technology',
  description:
    'Explore white-glove IT services from Geeky Clean Technology: home support, senior tech help, business IT, cybersecurity, data recovery, networking, computer repair, and remote support.',
};

const serviceCards = services.map((service) => ({
  title: service.title,
  description: service.subheadline,
  icon: service.features[0]?.icon ?? 'tabler:settings',
  callToAction: {
    text: 'Learn more',
    href: `/${service.slug}`,
    variant: 'link' as const,
    icon: 'tabler:arrow-right',
  },
}));
---

<Layout metadata={metadata}>
  <Hero
    id="hero"
    tagline="SERVICES"
    title="White-glove IT services for San Diego"
    subtitle="On-location and remote technology support for individuals, professionals, and small businesses."
    actions={[
      {
        variant: 'primary',
        text: 'Request Service',
        href: 'mailto:support@geekycleantechnology.com',
        class: 'shadow-[0_0_15px_rgba(34,211,238,0.5)] border-primary hover:shadow-[0_0_25px_rgba(34,211,238,0.8)]',
      },
      {
        text: 'Call 619-289-9205',
        href: 'tel:+16192899205',
      },
    ]}
  />

  <Features2
    id="services"
    title="Our Services"
    tagline="WHAT WE DO"
    columns={3}
    classes={{
      container: 'relative z-10',
      panel: 'glass-card glass-card-hover p-6 text-left',
      icon: 'text-primary w-10 h-10 mb-4',
    }}
    items={serviceCards}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'Email Us',
        href: 'mailto:support@geekycleantechnology.com',
        icon: 'tabler:mail',
        class: 'shadow-[0_0_15px_rgba(34,211,238,0.5)] border-primary',
      },
      {
        text: 'Call 619-289-9205',
        href: 'tel:+16192899205',
        icon: 'tabler:phone',
      },
    ]}
    title="Not sure which service fits?"
    subtitle="Tell us what is happening and we will match you with the right support. Call or email Geeky Clean Technology today."
  />
</Layout>
