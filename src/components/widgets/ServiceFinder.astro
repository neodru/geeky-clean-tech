---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { HOURLY_RATE, formatHours, formatPrice, priceFor, serviceCatalog } from '~/data/services';

export interface Props {
  id?: string;
  tagline?: string;
  title?: string;
  subtitle?: string;
}

const {
  id = 'service-finder',
  tagline = 'SERVICE FINDER',
  title = 'Look up a service.',
  subtitle = `Search our service catalog to see what each service includes, how long it usually takes, and what it costs at our standard $${HOURLY_RATE}/hr rate.`,
} = Astro.props;

// Every service is rendered on the server (so the list works without JavaScript and is
// indexable); the script below only shows or hides rows as the visitor searches.
const rows = serviceCatalog.flatMap((area) =>
  area.services.map((service) => ({
    ...service,
    area,
    // Price is always duration × hourly rate, rounded to the nearest dollar.
    price: priceFor(service.hours),
    search: `${service.title} ${service.description} ${area.title}`.toLowerCase(),
  }))
);
---

<WidgetWrapper id={id} containerClass="max-w-5xl mx-auto">
  <Headline tagline={tagline} title={title} subtitle={subtitle} />

  <gct-service-finder class="block">
    <div class="glass-card p-4 md:p-6 flex flex-col md:flex-row gap-3">
      <label class="relative flex-1">
        <span class="sr-only">Search services</span>
        <Icon
          name="tabler:search"
          class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-muted pointer-events-none"
        />
        <input
          type="search"
          data-finder-query
          placeholder="Try “iPhone”, “password”, or “hacked email”"
          autocomplete="off"
          class="w-full rounded-md border border-white/10 bg-white/5 py-3 pl-10 pr-3 text-gray-100 placeholder:text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
        />
      </label>
      <label class="md:w-72">
        <span class="sr-only">Filter by area</span>
        <select
          data-finder-area
          class="w-full rounded-md border border-white/10 bg-white/5 py-3 px-3 text-gray-100 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary [&>option]:bg-slate-900"
        >
          <option value="">All areas</option>
          {serviceCatalog.map((area) => <option value={area.id}>{area.title}</option>)}
        </select>
      </label>
    </div>

    <p class="mt-4 text-sm text-muted" aria-live="polite" data-finder-count>
      Showing all {rows.length} services
    </p>

    <ul class="mt-3 grid gap-3 max-h-[36rem] overflow-y-auto pr-1">
      {
        rows.map((row) => (
          <li data-finder-row data-area={row.area.id} data-search={row.search} class="glass-card p-5">
            <div class="flex flex-col sm:flex-row sm:items-start gap-3 sm:gap-6">
              <div class="flex-1">
                <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-primary">
                  <Icon name={row.area.icon} class="w-4 h-4" />
                  <span>{row.area.title}</span>
                </div>
                <h3 class="mt-1 font-semibold text-lg text-gray-100">{row.title}</h3>
                <p class="text-sm text-muted mt-1">{row.description}</p>
              </div>
              <dl class="flex sm:flex-col gap-6 sm:gap-1 sm:text-right shrink-0 sm:w-36">
                <div>
                  <dt class="sr-only">Duration</dt>
                  <dd class="text-sm text-muted flex items-center sm:justify-end gap-1">
                    <Icon name="tabler:clock" class="w-4 h-4" />
                    {formatHours(row.hours)}
                  </dd>
                </div>
                <div>
                  <dt class="sr-only">Price</dt>
                  <dd class="text-xl font-bold text-white">{formatPrice(row)}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))
      }
    </ul>

    <div data-finder-empty hidden class="glass-card mt-3 p-6 text-center">
      <p class="text-gray-100 font-semibold">No matching service found.</p>
      <p class="text-sm text-muted mt-1">
        Describe what you need and we will quote it, or <a href="tel:+16192899205" class="underline"
          >call 619-289-9205</a
        >.
      </p>
      <a href="/contact" class="btn btn-primary mt-4 inline-flex">Ask about a service</a>
    </div>

    <p class="mt-6 text-sm text-muted text-center">
      Prices are duration × ${HOURLY_RATE}/hr, rounded to the nearest dollar. “From” prices may take longer depending on
      your setup. Concierge members use their included monthly hours. <a href="/pricing" class="underline"
        >Full pricing</a
      >.
    </p>
  </gct-service-finder>
</WidgetWrapper>

<script>
  class GctServiceFinder extends HTMLElement {
    connectedCallback() {
      const query = this.querySelector<HTMLInputElement>('[data-finder-query]');
      const area = this.querySelector<HTMLSelectElement>('[data-finder-area]');
      const count = this.querySelector<HTMLElement>('[data-finder-count]');
      const empty = this.querySelector<HTMLElement>('[data-finder-empty]');
      const rows = Array.from(this.querySelectorAll<HTMLElement>('[data-finder-row]'));
      if (!query || !area || !count || !empty) return;

      const update = () => {
        // Every word must match somewhere in the title, description, or area name.
        const terms = query.value.toLowerCase().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const row of rows) {
          const text = row.dataset.search ?? '';
          const match = (!area.value || row.dataset.area === area.value) && terms.every((t) => text.includes(t));
          row.hidden = !match;
          if (match) shown++;
        }
        empty.hidden = shown > 0;
        count.textContent =
          shown === rows.length ? `Showing all ${rows.length} services` : `${shown} of ${rows.length} services match`;
      };

      query.addEventListener('input', update);
      area.addEventListener('change', update);
      update();
    }
  }

  if (!customElements.get('gct-service-finder')) {
    customElements.define('gct-service-finder', GctServiceFinder);
  }
</script>
