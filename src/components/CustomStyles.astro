---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
---

<style is:inline>
  :root,
  .dark {
    --aw-font-sans: 'Inter Variable', sans-serif;
    --aw-font-serif: 'Inter Variable', sans-serif;
    --aw-font-heading: 'Space Grotesk Variable', sans-serif;

    --aw-color-primary: #22d3ee; /* Electric Cyan */
    --aw-color-secondary: #a855f7; /* Magenta/Violet */
    --aw-color-accent: #e8d9b5; /* Champagne Gold */

    --aw-color-text-heading: #f5f5f7;
    --aw-color-text-default: #f5f5f7;
    --aw-color-text-muted: #a1a1aa;

    --aw-color-bg-page: #0a0a0f;
    --aw-color-bg-page-dark: #0d0f14;

    ::selection {
      background-color: #a855f7;
      color: #f5f5f7;
    }
  }
</style>
