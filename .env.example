# Build-time variables (Cloudflare Pages -> Settings -> Variables and secrets).
# Turnstile site key for the contact form. Leave unset to skip the widget.
PUBLIC_TURNSTILE_SITE_KEY=
# Optional: send the contact form somewhere other than /api/contact.
PUBLIC_CONTACT_FORM_ENDPOINT=

# Runtime variables for functions/api/contact.ts. Set these in Cloudflare, and
# in .dev.vars (not committed) when running `npx wrangler pages dev`.
# NOTION_TOKEN=             (secret) Notion internal integration token
# NOTION_DATABASE_ID=       Website Leads database ID
# TURNSTILE_SECRET_KEY=     (secret) enables the server-side Turnstile check
